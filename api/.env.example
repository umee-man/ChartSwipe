# ChartSwipe API settings (pydantic-settings; env vars are case-insensitive).
# Copy to .env and fill in. Never commit real values.

# postgres | memory (memory = volatile, for local UI hacking only)
REPOSITORY=postgres
# Supabase connection string; the role must be allowed to SET ROLE authenticated (`postgres` is).
# Default: Supavisor session pooler (IPv4). The direct host db.<project-ref>.supabase.co:5432 is IPv6-only
# unless the paid IPv4 add-on is enabled - use it only if the VPS has IPv6:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_POOL_MIN=1
DB_POOL_MAX=10
# Run JWT-scoped queries as role `authenticated` with request.jwt.claims so RLS applies.
DB_ENFORCE_RLS=true

# Supabase JWT verification: JWKS (asymmetric signing keys) is preferred.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Optional HS256 fallback for projects still on the legacy shared JWT secret. Leave empty to disable.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional issuer check, e.g. https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
JWKS_CACHE_TTL_SECONDS=600

# /v1/sync/* limit per API key (token bucket, in-memory, single replica)
SYNC_RATE_LIMIT_PER_MINUTE=30
# Per client IP on /v1/sync/*, checked before the key lookup (needs --proxy-headers behind Dokploy)
SYNC_IP_RATE_LIMIT_PER_MINUTE=120
SYNC_CURSOR_LAG_SECONDS=2

# JSON list of allowed browser origins for the PWA
CORS_ORIGINS=["http://localhost:3000"]

# Sentry for the API (architecture §11). Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
